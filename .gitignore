# 1. Ignorer les fichiers de variables secrets
.env
*.env
# (autorisation des modeles)
!.env.exemple

# 2. Ignorer les dossiers de configuration (Data)
# Si vous créez des dossiers "config" ou "data" à côté de vos compose.yaml, 
# Git ne les regardera jamais.
config/
data/
*/config/
*/data/

# 3. Ignorer les fichiers système polluants
.DS_Store
Thumbs.db